<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primario_suave" />
            <stroke
                android:width="1dp"
                android:color="@color/color_secundario" />
            <corners android:radius="@dimen/radius_base" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_superficie" />
            <stroke
                android:width="1dp"
                android:color="@color/color_secundario" />
            <corners android:radius="@dimen/radius_base" />
        </shape>
    </item>
</selector>
