<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <!-- Barra superior: Titulo y boton Nueva Tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTarjetasSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestion de Tarjetas de Credito"
                android:textColor="@color/colorPrimaryAccent"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cupos, fechas de corte/pago y tasas M.V."
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNuevaTarjeta"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/space_16"
            android:paddingRight="@dimen/space_16">

            <TextView
                android:id="@+id/tvBtnNuevaTarjetaIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/space_8"
                android:contentDescription="@null"
                android:textColor="@color/color_texto_invertido"
                android:textSize="@dimen/text_base" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tarjetas_nueva"
                android:textColor="@color/color_texto_invertido"
                android:textSize="@dimen/text_base"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tarjeta de resumen consolidado de cupos -->
    <LinearLayout
        android:id="@+id/cardResumenTarjetas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="RESUMEN CONSOLIDADO DE PLASTICOS"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cupo disponible"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/tvResumenCupoDisponible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="0.00"
                    android:textColor="@color/colorIncomeGreen"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cupo utilizado"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/tvResumenCupoUsado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="0.00"
                    android:textColor="@color/colorExpenseRed"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cupo total"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/tvResumenCupoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="0.00"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Estado vacio cuando no hay tarjetas -->
    <LinearLayout
        android:id="@+id/layoutEmptyCreditCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_24"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmptyCardsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:textColor="@color/color_texto_deshabilitado"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="@string/tarjetas_vacio"
            android:textColor="@color/colorTextSecondary"
            android:textSize="@dimen/text_base" />
    </LinearLayout>

    <!-- Contenedor de tarjetas de credito -->
    <LinearLayout
        android:id="@+id/creditCardsListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
